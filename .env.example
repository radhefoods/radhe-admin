# Copy this file to `.env.local` and adjust. Nothing here is a secret:
# every NEXT_PUBLIC_ value is visible in the browser. The panel has no secrets.

# The Radhe Foods API, without a slash at the end and without /v1.
# Local development: the mock API (`npm run dev:mock`) or radhe-api, both on port 3000.
# Production: https://api.radhefoods.de
NEXT_PUBLIC_API_URL=http://localhost:3000

# The customer shop, without a slash at the end. Used for "open in the shop" links.
# Production: https://www.radhefoods.de
NEXT_PUBLIC_SHOP_URL=http://localhost:3001
